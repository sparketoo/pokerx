{
    "name": "pokerx/backend",
    "type": "project",
    "keywords": [
        "php",
        "swoole",
        "framework",
        "hyperf",
        "microservice",
        "middleware"
    ],
    "description": "PokerX coroutine backend powered by Hyperf",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "ext-redis": "*",
        "ext-swoole": ">=6.2.1",
        "hyperf/amqp": "~3.2.0",
        "hyperf/async-queue": "~3.2.0",
        "hyperf/cache": "~3.2.0",
        "hyperf/command": "~3.2.0",
        "hyperf/config": "~3.2.0",
        "hyperf/constants": "~3.2.0",
        "hyperf/database": "~3.2.0",
        "hyperf/db-connection": "~3.2.0",
        "hyperf/engine": "^2.10",
        "hyperf/framework": "~3.2.0",
        "hyperf/guzzle": "~3.2.0",
        "hyperf/http-server": "~3.2.0",
        "hyperf/laminas-mime": "^3.0",
        "hyperf/logger": "~3.2.0",
        "hyperf/memory": "~3.2.0",
        "hyperf/model-cache": "~3.2.0",
        "hyperf/paginator": "~3.2",
        "hyperf/process": "~3.2.0",
        "hyperf/redis": "~3.2.0",
        "hyperf/translation": "~3.2.0",
        "hyperf/validation": "~3.2.0",
        "hyperf/websocket-client": "~3.2.0",
        "hyperf/websocket-server": "~3.2.0",
        "illuminate/encryption": "^13.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "hyperf/devtool": "~3.2.0",
        "hyperf/testing": "~3.2.0",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.0",
        "pestphp/pest": "^2.34",
        "phpstan/phpstan": "^2.2",
        "swoole/ide-helper": "^6.0"
    },
    "suggest": {
        "ext-openssl": "Required to use HTTPS.",
        "ext-json": "Required to use JSON.",
        "ext-pdo": "Required to use MySQL Client.",
        "ext-pdo_mysql": "Required to use MySQL Client.",
        "ext-redis": "Required to use Redis Client."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "test/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": [],
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-autoload-dump": [
            "rm -rf runtime/container"
        ],
        "test": "XDEBUG_MODE=off php vendor/bin/pest --test-directory=test",
        "pint": "pint",
        "phpstan": "phpstan analyse --memory-limit 300M",
        "lint": [
            "vendor/bin/pint --test",
            "@analyse"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php ./bin/hyperf.php start"
        ],
        "analyse": "phpstan analyse",
        "smoke": "python3 scripts/smoke_up.py"
    }
}
