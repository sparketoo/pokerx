# Docker Compose development defaults. Copy to .env before the first startup.
APP_NAME=PokerX
APP_ENV=dev
LOG_OUTPUT=php://stdout

# Generate a unique value before any production deployment and keep it stable.
APP_KEY=base64:4RXwsfBQ2jOlWtobzSStUS1pLQ1b0C51IQHG/rCcRXc=

# Host ports. The application always listens on 18080/18081 inside Docker.
HTTP_PORT=18080
POKER_WS_PORT=18081
MYSQL_PORT=3306
REDIS_PORT=6379

MYSQL_DATABASE=pokerx
MYSQL_USER=pokerx
MYSQL_PASSWORD=pokerx
MYSQL_ROOT_PASSWORD=root
REDIS_PREFIX=pokerx:

# mock makes the stack self-contained. Set proto plus PROTO_URL/PROTO_TOKEN for a real provider.
POKER_PROVIDER=mock
PROTO_URL=
PROTO_TOKEN=
PROTO_NETWORK=WE
